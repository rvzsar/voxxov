{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voxxov",
  "version": "0.1.0",
  "identifier": "com.voxxov.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Voxxov",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "decorations": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/data/transcripts/**",
          "$RESOURCE/data/jobs/**",
          "$RESOURCE/models/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Voxxov: portable voice-to-text using GigaAM-V3 (sherpa-onnx)",
    "longDescription": "Скачивает видео через yt-dlp, извлекает аудио через ffmpeg, распознаёт речь локально через GigaAM-V3 (ONNX RNN-T).",
    "publisher": "Voxxov",
    "copyright": "GPL-3.0-only",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [],
    "resources": [],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}
