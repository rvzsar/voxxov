{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GigaAM Desktop",
  "version": "0.1.0",
  "identifier": "com.gigaam.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GigaAM Desktop",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 520,
        "resizable": true,
        "decorations": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/transcripts/**", "$APPDATA/jobs/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "GigaAM-V3 desktop: yt-dlp + ffmpeg + ONNX",
    "longDescription": "Скачивает видео через yt-dlp, извлекает аудио через ffmpeg, распознаёт речь локально через GigaAM-V3 (ONNX RNN-T).",
    "publisher": "GigaAM Desktop",
    "copyright": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [],
    "resources": [],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
